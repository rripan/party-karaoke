# --- YouTube -------------------------------------------------------------
# YouTube Data API v3 key (server-side only). Without it the app runs in demo
# search mode with a clearly labelled sample catalog; pasted links still work.
YOUTUBE_API_KEY=
# Optional ISO 3166-1 region used to filter region-blocked videos (e.g. US, GB).
YOUTUBE_REGION_CODE=

# --- Database (Supabase Postgres) ----------------------------------------
# Postgres connection string. On Vercel use Supabase's *transaction pooler*
# URL (port 6543). Without it, parties are stored on this server (local mode).
DATABASE_URL=
# DATABASE_SSL=disable   # only for local Postgres without TLS

# --- Realtime (Supabase Realtime Broadcast) ------------------------------
# All three are needed for cross-instance realtime; otherwise the app uses
# Server-Sent Events from this server. The anon key is public by design; the
# service-role key must never be exposed to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Lyrics (optional, must be licensed for display) ---------------------
# A directory of <videoId>.json files you are licensed to display.
LYRICS_DATASET_DIR=
# Or an HTTP endpoint you operate/contract that implements the JSON contract in README.
LYRICS_PROVIDER_URL=
LYRICS_PROVIDER_API_KEY=
LYRICS_PROVIDER_NAME=

# --- App -------------------------------------------------------------------
# Public URL used in QR codes (recommended in production), e.g. https://karaoke.example.com
APP_URL=
# Secret for /api/cron/cleanup (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Idle parties expire after this many hours; ended parties are purged after N days.
PARTY_TTL_HOURS=24
HISTORY_RETENTION_DAYS=7
